PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=
# Supabase Session pooler or Direct Postgres connection. Backend only.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. A new Supabase Secret key also works as SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER=gemini
LLM_TIMEOUT_MS=15000
GEMINI_THINKING_BUDGET=0
LLM_REACTIONS=on
# Set none to disable generation even if a key is present.
LLM_PROVIDER=gemini
RAG_MATCH_THRESHOLD=0.72
RAG_PREP_THRESHOLD=0.5
# Explicit CLI setup only. No automatic persistent test users on startup.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
ADMIN_EMAILS=
# Nonproduction local preview only (in-memory; no upload or persistence):
# STORE_BACKEND=memory
