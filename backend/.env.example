PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase Dashboard > Connect > Session pooler (or Direct on IPv6 networks).
# Replace the password locally; never commit backend/.env.
DATABASE_URL=

# Set to "production" when deploying. Outside production the demo login
# (test@interviewai.dev / password123) is created on startup.
NODE_ENV=development
# Force the demo login even in production (demos only).
SEED_TEST_ACCOUNT=false

# Number of reverse proxies in front of the backend (nginx in docker-compose = 1).
# Needed so the login rate limiter sees real client IPs.
TRUST_PROXY=

# Optional: let Google's Gemini API write the post-interview chat replies and the
# interviewer's short reactions. Leave the key empty to keep the scripted replies.
# Put your real key in backend/.env only (that file is git-ignored). Never in frontend/.
# Note: interview transcripts are sent to Google when this is set.
GEMINI_API_KEY=
# "gemini-flash-latest" follows Google's current flash model. Pin a specific model if you prefer.
# Google retires old versions for new keys (gemini-2.5-flash already returns 404).
GEMINI_MODEL=gemini-flash-latest
LLM_TIMEOUT_MS=15000
# Thinking tokens make replies several seconds slower, so they are off (0) by default.
# Set to "default" to let the model decide.
GEMINI_THINKING_BUDGET=0
# "off" stops the model from writing the interviewer's reaction after each answer (the chat still
# uses it). Free API tiers can be as low as 20 requests per day per model.
LLM_REACTIONS=on
# "off" stops the model writing the per-answer review shown on the feedback page (structured JSON,
# validated against backend/src/schemas/critique.js). Without it the app shows a basic review.
LLM_CRITIQUE=on

# --- Local model instead of Gemini (LM Studio, Ollama, llama.cpp) ---
# LLM_PROVIDER=local wins over a Gemini key. Start the server in LM Studio (Developer tab, Status:
# Running) with a model loaded. Model inference stays local, but application data
# and uploaded documents still live in your Supabase project.
LLM_PROVIDER=
LOCAL_LLM_URL=http://localhost:1234/v1
# Leave empty to use the first chat model the server lists (embedding models are skipped).
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# Optional RAG over the current interview, stored in Supabase pgvector.
# Set EMBEDDING_PROVIDER=gemini or local. Local models must return 768 dimensions.
EMBEDDING_PROVIDER=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LOCAL_EMBEDDING_MODEL=
# Optional global override. Defaults: Gemini 0.60, local 0.65.
# Calibrate with npm run eval:long before changing these values.
RAG_MATCH_THRESHOLD=
RAG_MATCH_THRESHOLD_GEMINI=
RAG_MATCH_THRESHOLD_LOCAL=
# Minimum document similarity for adding context to a scenario question.
RAG_PREP_THRESHOLD=0.5

# Private Supabase Storage bucket is created by backend/sql/002_rag.sql.
# Use the Secret key from Settings > API Keys. Keep it ONLY in backend/.env.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback for dashboards that only show the old service_role key.
# SUPABASE_SERVICE_ROLE_KEY=

# Temporary local preview only. No persistence or document upload; never use in production.
# STORE_BACKEND=memory
