{
  "name": "interviewai-backend",
  "version": "0.1.0",
  "description": "InterviewAI backend API (auth, scenarios, live session, rubric scoring, progress)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "index:questions": "node scripts/indexQuestions.js",
    "check:schema": "node scripts/checkSchema.js",
    "migrate:documents": "node scripts/migrateDocuments.js",
    "smoke:documents": "node scripts/smokeDocuments.js",
    "eval:long": "node eval/runLong.js",
    "eval:long:live": "node eval/runLong.js --live",
    "migrate:followup": "node scripts/applyFollowupMigrations.js",
    "reindex:documents": "node scripts/reindexDocuments.js",
    "check:model-stream": "node scripts/checkModelStream.js",
    "eval": "node eval/run.js",
    "seed:auth": "node scripts/seedSupabaseUser.js",
    "bootstrap:admins": "node scripts/bootstrapAdmins.js",
    "eval:duc": "node eval/runDuc.js",
    "eval:duc:live": "node eval/runDucLive.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12"
  },
  "overrides": {
    "body-parser": "1.20.9"
  }
}
